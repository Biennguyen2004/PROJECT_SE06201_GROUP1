<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/darker_gray"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Điều Khiển Đèn"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Điều khiển Đèn 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Đèn 1"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start"/>

        <ToggleButton
            android:id="@+id/toggle_light1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="TẮT"
            android:textOff="BẬT"/>
    </LinearLayout>

    <!-- Điều khiển Đèn 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Đèn 2"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start"/>

        <ToggleButton
            android:id="@+id/toggle_light2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="TẮT"
            android:textOff="BẬT"/>
    </LinearLayout>

    <!-- Điều khiển Đèn 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Đèn 3"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start"/>

        <ToggleButton
            android:id="@+id/toggle_light3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="TẮT"
            android:textOff="BẬT"/>
    </LinearLayout>

    <!-- Điều khiển Đèn 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Đèn 4"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start"/>

        <ToggleButton
            android:id="@+id/toggle_light4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="TẮT"
            android:textOff="BẬT"/>
    </LinearLayout>

    <!-- Điều khiển Auto Đèn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Chế độ Auto"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start"/>

        <ToggleButton
            android:id="@+id/toggle_auto_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="TẮT"
            android:textOff="BẬT"/>
    </LinearLayout>

    <Button
        android:id="@+id/backLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trờ về"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar_light"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"/>
</LinearLayout>
