<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="#EAFDEE"
            android:orientation="vertical">

            <!-- Ảnh nền -->
            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="500dp"
                android:layout_height="500dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_light_bg" />

            <!-- Nền trắng bo cong -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:orientation="vertical"
                android:background="@drawable/login_background_bottom"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/img_back_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back"/>

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/black"
                    android:text="Light Control" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <!-- Công tắc bật/tắt đèn 11111-->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="30dp"
                                android:text="Light 1"/>

                            <Switch
                                android:id="@+id/switchLight1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:track="@drawable/bg_track"
                                android:scaleX="1.8"
                                android:scaleY="1.8" />
                        </LinearLayout>

                        <!-- Công tắc bật/tắt đèn 2222-->
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="30dp"
                                android:text="Light 2"/>

                            <Switch
                                android:id="@+id/switchLight2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:track="@drawable/bg_track"
                                android:scaleX="1.8"
                                android:scaleY="1.8" />
                        </LinearLayout>

                        <!-- Công tắc bật/tắt đèn 3333-->
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="30dp"
                                android:text="Light 3"/>

                            <Switch
                                android:id="@+id/switchLight3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:track="@drawable/bg_track"
                                android:scaleX="1.8"
                                android:scaleY="1.8" />
                        </LinearLayout>

                        <!-- Công tắc bật/tắt đèn 4444-->
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="30dp"
                                android:text="Light 4"/>

                            <Switch
                                android:id="@+id/switchLight4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:track="@drawable/bg_track"
                                android:scaleX="1.8"
                                android:scaleY="1.8" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/img_back_h"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/light_bg"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Công tắc bật/tắt đèn 4444-->
                <LinearLayout
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:background="@color/white"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="30dp"
                        android:text="Auto light"/>

                    <Switch
                        android:id="@+id/switchLight_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:track="@drawable/bg_track"
                        android:scaleX="1.8"
                        android:scaleY="1.8" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
